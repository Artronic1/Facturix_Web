@model List<FacturixWeb.ViewModels.ReceivableViewModel>
@{
    ViewData["Title"] = "Cuentas por Cobrar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="section-title">Cuentas por Cobrar</h1>
        <p class="section-subtitle">Gestión de créditos (fiados) y abonos de clientes.</p>
    </div>
</div>

<div class="card page-card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-check-circle fs-1 mb-3"></i>
                <h5>No hay cuentas por cobrar pendientes.</h5>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Teléfono</th>
                            <th class="text-end">Deuda Total</th>
                            <th>Última Actualización</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ClienteNombre</td>
                            <td>@item.ClienteTelefono</td>
                            <td class="text-end text-danger fw-bold">RD$ @item.DeudaTotal.ToString("N2")</td>
                            <td>@item.UltimaActualizacion</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.ClienteId" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i> Ver Detalles / Abonar
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
