@using InventarioProVisual.Models
@model List<Caja>

@{
    ViewData["Title"] = "Historial de Cajas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-clock-history text-primary me-2"></i>Historial de Cajas</h1>
    <a asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left me-1"></i>Volver a la Caja
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3"># Caja</th>
                        <th class="py-3">Apertura</th>
                        <th class="py-3">Cierre</th>
                        <th class="py-3 text-end">Saldo Inicial</th>
                        <th class="py-3 text-end">Efectivo Final Físico</th>
                        <th class="py-3 text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var caja in Model)
                        {
                            <tr>
                                <td class="px-4 fw-bold text-muted">@caja.Id</td>
                                <td>@caja.Apertura</td>
                                <td>@(caja.Cierre?.ToString() ?? "---")</td>
                                <td class="text-end font-monospace">RD$ @caja.SaldoInicial.ToString("N2")</td>
                                <td class="text-end font-monospace fw-bold text-primary">RD$ @caja.SaldoFinal.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge bg-secondary rounded-pill">CERRADA</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                                No hay historial de cajas cerradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
