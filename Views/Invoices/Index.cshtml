@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Facturas Emitidas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-receipt text-primary me-2"></i>Facturas Emitidas</h1>
    <a asp-controller="Sales" asp-action="Index" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Nueva Venta
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Fecha Inicio</label>
                <input type="date" name="start" class="form-control" value="@ViewBag.Start">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Fecha Fin</label>
                <input type="date" name="end" class="form-control" value="@ViewBag.End">
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search me-1"></i>Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3"># Factura</th>
                        <th class="py-3">Fecha</th>
                        <th class="py-3">Cliente</th>
                        <th class="py-3">Método</th>
                        <th class="py-3 text-end">Total</th>
                        <th class="py-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-bold text-muted">@item.Id.ToString("000000")</td>
                                <td>@item.Fecha</td>
                                <td>@item.ClienteNombre</td>
                                <td>
                                    <span class="badge @(item.MetodoPago == "CREDITO" ? "bg-warning text-dark" : "bg-success") rounded-pill px-3">
                                        @item.MetodoPago
                                    </span>
                                </td>
                                <td class="text-end font-monospace fw-bold text-primary">RD$ @item.Total.ToString("N2")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Ver Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Receipt" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Descargar Recibo" target="_blank">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de anular y eliminar esta factura de forma permanente? El inventario y los cuadres de caja se revertirán.');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                                No se encontraron facturas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
