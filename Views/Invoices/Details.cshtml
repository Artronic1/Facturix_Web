@model dynamic

@{
    ViewData["Title"] = $"Factura #{Model.Id.ToString("000000")}";
    var detalles = ViewBag.Detalles as IEnumerable<dynamic>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
        <h1 class="h3 mb-0 text-gray-800">
            <i class="bi bi-receipt text-primary me-2"></i>Factura #@Model.Id.ToString("000000")
        </h1>
    </div>
    <div>
        <a asp-action="Receipt" asp-route-id="@Model.Id" class="btn btn-outline-primary" target="_blank">
            <i class="bi bi-printer me-1"></i>Imprimir Recibo
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-light border-0 py-3">
                <h5 class="mb-0 text-muted"><i class="bi bi-info-circle me-2"></i>Datos de la Factura</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Fecha</span>
                        <span class="fw-bold">@Model.Fecha</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Cliente</span>
                        <span class="fw-bold text-end">@Model.ClienteNombre</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Método</span>
                        <span class="badge @(Model.MetodoPago == "CREDITO" ? "bg-warning text-dark" : "bg-success")">
                            @Model.MetodoPago
                        </span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <span class="text-muted">NCF</span>
                        <span class="font-monospace">@(string.IsNullOrEmpty(Model.Ncf) ? "N/A" : Model.Ncf)</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Total</span>
                        <span class="fs-5 fw-bold text-primary">RD$ @Model.Total.ToString("N2")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-8 mb-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-light border-0 py-3">
                <h5 class="mb-0 text-muted"><i class="bi bi-cart me-2"></i>Detalle de Productos</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="px-4 py-3">Producto</th>
                                <th class="py-3 text-center">Cant.</th>
                                <th class="py-3 text-end">Precio U.</th>
                                <th class="py-3 text-end">Subtotal</th>
                                @if (User.IsInRole("Admin"))
                                {
                                    <th class="py-3 text-center">Edición</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (detalles != null && detalles.Any())
                            {
                                foreach (var item in detalles)
                                {
                                    <tr>
                                        <td class="px-4 fw-bold">@item.ProductoNombre</td>
                                        <td class="text-center">@item.Cantidad</td>
                                        <td class="text-end font-monospace">RD$ @item.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end font-monospace fw-bold">RD$ @item.Total.ToString("N2")</td>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <td class="text-center">
                                                <form asp-action="DeleteItem" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este producto de la factura? Esto ajustará la caja y el inventario.');">
                                                    <input type="hidden" name="facturaId" value="@Model.Id" />
                                                    <input type="hidden" name="ventaId" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar Producto" @(detalles.Count() == 1 ? "disabled" : "")>
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No hay detalles.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (User.IsInRole("Admin") && detalles != null && detalles.Count() == 1)
            {
                <div class="card-footer bg-light border-0 py-3 text-muted small">
                    <i class="bi bi-info-circle me-1"></i>No puedes eliminar el único producto. Si deseas anular toda la factura, bórrala desde el historial.
                </div>
            }
        </div>
    </div>
</div>
