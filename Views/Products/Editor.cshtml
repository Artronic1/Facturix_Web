@model ProductEditorViewModel
@{
    ViewData["Title"] = Model.Id is null ? "Nuevo producto" : "Editar producto";
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="form-panel">
            <h1 class="section-title">@(Model.Id is null ? "Nuevo producto" : "Editar producto")</h1>
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Precio" class="form-label"></label>
                        <input asp-for="Precio" class="form-control" />
                        <span asp-validation-for="Precio" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Stock" class="form-label"></label>
                        <input asp-for="Stock" class="form-control" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>
                <div class="mt-3 mb-4">
                    <label asp-for="CodigoBarras" class="form-label"></label>
                    <input asp-for="CodigoBarras" class="form-control" />
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Guardar producto</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>

                <div class="mt-4">
                    <h3 class="h5 fw-bold">Componentes de combo</h3>
                    <p class="text-muted small">Complete solo las filas que desea usar. Si deja todo vacío, el producto se guarda como artículo normal.</p>
                    @for (var i = 0; i < Model.Componentes.Count; i++)
                    {
                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-md-8">
                                <select asp-for="Componentes[i].ProductoId" class="form-select">
                                    <option value="0">Seleccione producto</option>
                                    @foreach (var option in Model.ProductosDisponibles)
                                    {
                                        <option value="@option.Value">@option.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <input asp-for="Componentes[i].Cantidad" class="form-control" min="0" />
                            </div>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
