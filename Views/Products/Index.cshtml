@model ProductIndexViewModel
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
    <div>
        <h1 class="section-title">Inventario de productos</h1>
        <p class="section-subtitle">Administre catálogo, códigos de barras, stock y combos del sistema.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo producto</a>
</div>

<div class="card page-card">
    <div class="card-body">
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-6 col-xl-4">
                <input name="search" value="@Model.Search" class="form-control" placeholder="Buscar por nombre o código..." />
            </div>
            <div class="col-auto">
                <button class="btn btn-secondary">Buscar</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Código</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Stock</th>
                        <th>Combo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.Nombre</div>
                            @if (!string.IsNullOrWhiteSpace(item.ComboResumen))
                            {
                                <div class="small text-muted">@item.ComboResumen</div>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.CodigoBarras) ? "-" : item.CodigoBarras)</td>
                        <td class="text-end">RD$ @item.Precio.ToString("N2")</td>
                        <td class="text-end">@item.Stock</td>
                        <td>@(item.EsCombo ? "Sí" : "No")</td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end flex-wrap">
                                <form asp-action="Restock" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="number" name="quantity" min="1" value="1" class="form-control form-control-sm" style="width:92px;" />
                                    <button class="btn btn-sm btn-success">Reabastecer</button>
                                </form>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar este producto?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-sm btn-danger">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
