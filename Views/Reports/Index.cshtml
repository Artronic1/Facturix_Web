@model ReportsIndexViewModel
@{
    ViewData["Title"] = "Reportes";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
    <div>
        <h1 class="section-title">Reportes de ventas</h1>
        <p class="section-subtitle">Consulte ventas por fecha y exporte el resumen a Excel.</p>
    </div>
    <a asp-action="Export" asp-route-desde="@Model.Desde.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta.ToString("yyyy-MM-dd")" class="btn btn-success">Exportar Excel</a>
</div>

<div class="card page-card">
    <div class="card-body">
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-3">
                <label asp-for="Desde" class="form-label"></label>
                <input asp-for="Desde" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Hasta" class="form-label"></label>
                <input asp-for="Hasta" class="form-control" />
            </div>
            <div class="col-auto align-self-end">
                <button class="btn btn-secondary">Filtrar</button>
            </div>
            <div class="col-auto align-self-end">
                <span class="stat-chip">Total período: RD$ @Model.TotalRecaudado.ToString("N2")</span>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th class="text-end">Ventas</th>
                        <th class="text-end">Unidades</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Fecha</td>
                        <td class="text-end">@item.NumeroVentas</td>
                        <td class="text-end">@item.UnidadesVendidas</td>
                        <td class="text-end">RD$ @item.TotalVendido.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
