@model ExpenseIndexViewModel
@{
    ViewData["Title"] = "Gastos";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="section-title">Gastos operativos</h1>
        <p class="section-subtitle">Registro y control de egresos del negocio.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Registrar gasto</a>
</div>

<div class="card page-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Concepto</th>
                        <th>Categoría</th>
                        <th>Fecha</th>
                        <th class="text-end">Monto</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.Concepto</td>
                        <td>@item.Categoria</td>
                        <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">RD$ @item.Monto.ToString("N2")</td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar este gasto?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-sm btn-danger">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
