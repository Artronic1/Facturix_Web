@model ExpenseEditorViewModel
@{
    ViewData["Title"] = Model.Id is null ? "Registrar gasto" : "Editar gasto";
}

<div class="row">
    <div class="col-lg-6">
        <div class="form-panel">
            <h1 class="section-title">@(Model.Id is null ? "Registrar gasto" : "Editar gasto")</h1>
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Concepto" class="form-label"></label>
                    <input asp-for="Concepto" class="form-control" />
                    <span asp-validation-for="Concepto" class="text-danger"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Categoria" class="form-label"></label>
                        <select asp-for="Categoria" class="form-select">
                            <option>LUZ</option>
                            <option>RENTA</option>
                            <option>SUELDOS</option>
                            <option>COMPRAS</option>
                            <option>MANTENIMIENTO</option>
                            <option>OTROS</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Monto" class="form-label"></label>
                        <input asp-for="Monto" class="form-control" />
                    </div>
                </div>
                <div class="mt-3 mb-4">
                    <label asp-for="Fecha" class="form-label"></label>
                    <input asp-for="Fecha" class="form-control" />
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary">Guardar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
