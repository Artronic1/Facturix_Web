@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between mb-4">
    <div>
        <h1 class="section-title">Dashboard</h1>
        <p class="section-subtitle">Resumen operativo de ventas, caja, gastos e inventario en tiempo real.</p>
    </div>
    <div class="d-flex align-items-center gap-3">
        @if (!Model.CajaAbierta)
        {
            <span class="stat-chip" style="background:linear-gradient(135deg,#475569,#64748b);">Caja Cerrada</span>
            <form asp-controller="Sales" asp-action="OpenCash" method="post" class="d-inline-flex align-items-center gap-2">
                @Html.AntiForgeryToken()
                <input type="number" step="0.01" min="0" name="initialAmount" value="0" class="form-control form-control-sm" style="width:120px;" placeholder="Monto inicial" />
                <button class="btn btn-sm btn-primary">Abrir caja</button>
            </form>
        }
        else
        {
            <span class="stat-chip">Caja Abierta</span>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card kpi-card kpi-blue p-3">
            <div class="label">Ventas de hoy</div>
            <div class="value">RD$ @Model.VentasHoy.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card kpi-card kpi-red p-3">
            <div class="label">Gastos de hoy</div>
            <div class="value">RD$ @Model.GastosHoy.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card kpi-card kpi-green p-3">
            <div class="label">Utilidad del día</div>
            <div class="value">RD$ @Model.UtilidadHoy.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card kpi-card @(Model.CajaAbierta ? "kpi-orange" : "kpi-slate") p-3">
            <div class="label">Estado de caja</div>
            <div class="value">@(Model.CajaAbierta ? "ABIERTA" : "CERRADA")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kpi-card kpi-slate p-3">
            <div class="label">Operaciones</div>
            <div class="value">@Model.TransaccionesHoy</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kpi-card kpi-purple p-3">
            <div class="label">Unidades vendidas</div>
            <div class="value">@Model.UnidadesVendidas</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kpi-card kpi-blue p-3">
            <div class="label">Productos en catálogo</div>
            <div class="value">@Model.ProductosActivos</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-6">
        <div class="card page-card h-100">
            <div class="card-header">Top productos</div>
            <div class="card-body">
                <div style="position:relative; width:100%; max-height:260px; height:260px;">
                    <canvas id="topProductosChart"></canvas>
                </div>
                <hr class="my-4" />
                @if (Model.TopProductos.Count == 0)
                {
                    <p class="text-muted mb-0">Todavía no hay ventas registradas.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.TopProductos)
                            {
                                <tr>
                                    <td>@item.Nombre</td>
                                    <td class="text-end fw-semibold">@item.Total</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card page-card h-100">
            <div class="card-header">Balance semanal</div>
            <div class="card-body">
                <div style="position:relative; width:100%; max-height:260px; height:260px;">
                    <canvas id="balanceChart"></canvas>
                </div>
                <hr class="my-4" />
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th class="text-end">Ventas</th>
                                <th class="text-end">Gastos</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.BalanceSemanal)
                        {
                            <tr>
                                <td>@item.Fecha</td>
                                <td class="text-end text-success fw-semibold">RD$ @item.Ventas.ToString("N2")</td>
                                <td class="text-end text-danger fw-semibold">RD$ @item.Gastos.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card page-card">
            <div class="card-header">Alertas de reabastecimiento</div>
            <div class="card-body">
                @if (Model.AlertasStock.Count == 0)
                {
                    <p class="mb-0 text-muted">Todo el inventario se encuentra en niveles correctos.</p>
                }
                else
                {
                    <div class="row g-3">
                    @foreach (var item in Model.AlertasStock)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="alert-stock p-3">
                                <div class="fw-bold">@item.Nombre</div>
                                <div class="text-danger">Stock actual: @item.Stock</div>
                            </div>
                        </div>
                    }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Datos para Top Productos
            var topProductosLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopProductos.Select(x => x.Nombre)));
            var topProductosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopProductos.Select(x => x.Total)));

            var ctxTop = document.getElementById('topProductosChart').getContext('2d');
            new Chart(ctxTop, {
                type: 'doughnut',
                data: {
                    labels: topProductosLabels,
                    datasets: [{
                        label: 'Unidades Vendidas',
                        data: topProductosData,
                        backgroundColor: [
                            'rgba(99, 102, 241, 0.8)',
                            'rgba(16, 185, 129, 0.8)',
                            'rgba(245, 158, 11, 0.8)',
                            'rgba(239, 68, 68, 0.8)',
                            'rgba(139, 92, 246, 0.8)',
                            'rgba(14, 165, 233, 0.8)'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: { color: 'rgba(203,213,225,0.85)', font: { family: 'Inter' } }
                        }
                    }
                }
            });

            // Datos para Balance Semanal
            var balanceLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BalanceSemanal.Select(x => x.Fecha)));
            var ventasData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BalanceSemanal.Select(x => x.Ventas)));
            var gastosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BalanceSemanal.Select(x => x.Gastos)));

            var ctxBalance = document.getElementById('balanceChart').getContext('2d');
            new Chart(ctxBalance, {
                type: 'bar',
                data: {
                    labels: balanceLabels,
                    datasets: [
                        {
                            label: 'Ventas (RD$)',
                            data: ventasData,
                            backgroundColor: 'rgba(16, 185, 129, 0.8)',
                            borderRadius: 4
                        },
                        {
                            label: 'Gastos (RD$)',
                            data: gastosData,
                            backgroundColor: 'rgba(239, 68, 68, 0.8)',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, ticks: { color: 'rgba(148,163,184,0.7)' }, grid: { color: 'rgba(255,255,255,0.06)' } },
                        x: { ticks: { color: 'rgba(148,163,184,0.7)' }, grid: { color: 'rgba(255,255,255,0.04)' } }
                    },
                    plugins: {
                        legend: { labels: { color: 'rgba(203,213,225,0.85)', font: { family: 'Inter' } } }
                    }
                }
            });
        });
    </script>
}
