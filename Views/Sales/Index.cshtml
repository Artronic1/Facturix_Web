@model SalesPageViewModel
@{
    ViewData["Title"] = "Ventas";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
    <div>
        <h1 class="section-title">Ventas y caja</h1>
        <p class="section-subtitle">Busque productos, arme el carrito, cobre, guarde cotizaciones y controle la caja del día.</p>
    </div>
    <div class="d-flex align-items-center gap-3">
        @if (!Model.CajaAbierta)
        {
            <span class="stat-chip" style="background:linear-gradient(135deg,#475569,#64748b);">Caja Cerrada</span>
            <form asp-controller="CashRegister" asp-action="OpenCash" method="post" class="d-inline-flex align-items-center gap-2">
                @Html.AntiForgeryToken()
                <input type="number" step="0.01" min="0" name="initialAmount" value="0" class="form-control form-control-sm" style="width:120px;" placeholder="Monto inicial" />
                <button class="btn btn-sm btn-primary">Abrir caja</button>
            </form>
        }
        else
        {
            <span class="stat-chip">Caja Abierta</span>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-7">
        <div class="card page-card mb-4">
            <div class="card-header">Productos</div>
            <div class="card-body">
                <form method="get" class="row g-3 mb-4">
                    <div class="col-md-8">
                        <input name="search" value="@Model.Search" class="form-control" placeholder="Buscar por nombre o código de barras..." autofocus />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-secondary">Buscar</button>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="text-end">Precio</th>
                                <th class="text-end">Stock</th>
                                <th class="text-end">Agregar</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Productos)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td class="text-end">RD$ @item.Precio.ToString("N2")</td>
                                <td class="text-end">@item.Stock</td>
                                <td class="text-end">
                                    <form asp-action="AddToCart" method="post" data-ajax="true" class="d-inline-flex gap-2 justify-content-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <input type="hidden" name="search" value="@Model.Search" />
                                        <input type="number" name="quantity" min="1" max="@item.Stock" value="1" class="form-control form-control-sm" style="width:84px;" />
                                        <button class="btn btn-sm btn-primary">Añadir</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card page-card">
            <div class="card-header">Cotizaciones pendientes</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Cliente</th>
                                <th>Estado</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.CotizacionesPendientes)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td>@item.Cliente</td>
                                <td>@item.Estado</td>
                                <td class="text-end">RD$ @item.Total.ToString("N2")</td>
                                <td class="text-end">
                                    <a asp-action="LoadQuote" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Cargar</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="cart-summary mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase small opacity-75">Carrito actual</div>
                    <div class="h4 mb-0">@(Model.CotizacionCargadaLabel ?? "Venta libre")</div>
                </div>
                <form asp-action="ClearCart" method="post" data-ajax="true">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-light">Limpiar</button>
                </form>
            </div>
            <hr class="border-light opacity-25" />
            <div class="table-responsive">
                <table class="table table-dark table-borderless align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="text-end">Cant.</th>
                            <th class="text-end">Precio</th>
                            <th class="text-end">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Carrito)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td class="text-end">
                                <form asp-action="UpdateQuantity" method="post" data-ajax="true" class="d-inline-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="number" name="quantity" min="0" max="@item.Stock" value="@item.Quantity" class="form-control form-control-sm" style="width:78px;" />
                                    <button class="btn btn-sm btn-outline-light">OK</button>
                                </form>
                            </td>
                            <td class="text-end">RD$ @item.Price.ToString("N2")</td>
                            <td class="text-end">RD$ @item.Total.ToString("N2")</td>
                            <td class="text-end">
                                <form asp-action="RemoveFromCart" method="post" data-ajax="true">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button class="btn btn-sm btn-outline-danger">Quitar</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <hr class="border-light opacity-25" />
            <form asp-action="SetDiscount" method="post" data-ajax="true" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-sm-6">
                    <label class="form-label text-white">Descuento %</label>
                    <input type="number" step="0.01" min="0" max="100" name="discountPercent" value="@Model.DiscountPercent" class="form-control" />
                </div>
                <div class="col-sm-6">
                    <button class="btn btn-outline-light w-100">Actualizar descuento</button>
                </div>
            </form>
            <div class="mt-3 small">
                <div class="d-flex justify-content-between"><span>Subtotal</span><strong>RD$ @Model.Subtotal.ToString("N2")</strong></div>
                <div class="d-flex justify-content-between"><span>Descuento</span><strong>RD$ @Model.DescuentoMonto.ToString("N2")</strong></div>
                <div class="d-flex justify-content-between fs-5 mt-2"><span>Total</span><strong>RD$ @Model.Total.ToString("N2")</strong></div>
            </div>
        </div>

        <div class="form-panel mb-4">
            <h2 class="h4 fw-bold">Cobrar</h2>
            <form asp-action="Checkout" method="post" id="checkoutForm">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Cliente</label>
                    <select name="customerId" class="form-select" id="checkoutCustomer">
                        @foreach (var customer in Model.Clientes)
                        {
                            <option value="@customer.Id">@customer.Nombre</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Método de Pago</label>
                    <select name="metodoPago" class="form-select" id="metodoPagoSelect" onchange="toggleAmountReceived()">
                        <option value="EFECTIVO">Efectivo</option>
                        <option value="TARJETA">Tarjeta</option>
                        <option value="TRANSFERENCIA">Transferencia</option>
                        <option value="CREDITO">Crédito (Fiado)</option>
                    </select>
                </div>
                <div class="mb-3" id="amountReceivedContainer">
                    <label class="form-label">Monto recibido</label>
                    <input type="number" step="0.01" min="0" name="amountReceived" id="amountReceived" value="@Model.AmountReceived" class="form-control" />
                </div>
                <button class="btn btn-success w-100" @(Model.CajaAbierta ? null : "disabled")>Cobrar venta</button>
            </form>
        </div>

        <script>
            function toggleAmountReceived() {
                var select = document.getElementById('metodoPagoSelect');
                var container = document.getElementById('amountReceivedContainer');
                var input = document.getElementById('amountReceived');
                if (select.value === 'CREDITO') {
                    container.style.display = 'none';
                    input.value = '0';
                } else {
                    container.style.display = 'block';
                    input.value = '@Model.AmountReceived.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)';
                }
            }
        </script>



    </div>
</div>



@section Scripts {
    @if (TempData["DownloadReceipt"] != null)
    {
        <script>
            window.addEventListener('load', function() {
                var url = '@Url.Action("Receipt", "Invoices", new { id = TempData["DownloadReceipt"] })';
                var a = document.createElement('a');
                a.href = url;
                a.target = '_blank';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            });
        </script>
    }
}
