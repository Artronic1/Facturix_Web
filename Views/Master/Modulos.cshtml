@model List<FacturixWeb.Controllers.ModuloViewModel>
@{
    ViewData["Title"] = "Catálogo de Módulos";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold">Catálogo de Módulos</h1>
        <p class="text-muted">Crea y administra las características adicionales que puedes asignarle a tus inquilinos.</p>
    </div>
    <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#crearModuloModal">
        <i class="bi bi-plus-lg me-2"></i>Nuevo Módulo
    </button>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Código Interno</th>
                        <th>Nombre Comercial</th>
                        <th>Descripción</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-puzzle text-light" style="font-size: 3rem;"></i>
                                <p class="mt-3 mb-0">No hay módulos registrados en el catálogo.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var mod in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-secondary">@mod.Codigo</span>
                            </td>
                            <td class="fw-bold">@mod.Nombre</td>
                            <td class="text-muted small">@mod.Descripcion</td>
                            <td class="text-end pe-4">
                                <form asp-action="EliminarModulo" method="post" class="m-0" onsubmit="return confirm('¿Estás seguro de eliminar este módulo del catálogo?');">
                                    <input type="hidden" name="id" value="@mod.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar Módulo">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Crear Módulo -->
<div class="modal fade" id="crearModuloModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CrearModulo" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Registrar Nuevo Módulo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre Comercial</label>
                        <input type="text" name="nombre" class="form-control" required placeholder="Ej. Módulo de Taller" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Código Interno (Feature Flag)</label>
                        <input type="text" name="codigo" class="form-control text-uppercase" required placeholder="Ej. MOD_TALLER" />
                        <small class="text-muted">Este código se usará en C# para verificar si la empresa tiene el módulo activo.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea name="descripcion" class="form-control" rows="2" placeholder="Breve descripción de lo que hace el módulo"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear Módulo</button>
                </div>
            </form>
        </div>
    </div>
</div>
