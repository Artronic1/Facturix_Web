@model CustomerIndexViewModel
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="section-title">Clientes</h1>
        <p class="section-subtitle">Base de clientes y datos comerciales para ventas y cotizaciones.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo cliente</a>
</div>

<div class="card page-card">
    <div class="card-body">
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-5">
                <input name="search" value="@Model.Search" class="form-control" placeholder="Buscar cliente..." />
            </div>
            <div class="col-auto">
                <button class="btn btn-secondary">Buscar</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                        <th>Dirección</th>
                        <th>RNC / Cédula</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.Nombre</td>
                        <td>@(item.Telefono ?? "-")</td>
                        <td>@(item.Direccion ?? "-")</td>
                        <td>@(item.Rnc ?? "-")</td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                @if (item.Id != 1)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                                    <form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar este cliente?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn btn-sm btn-danger">Eliminar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
