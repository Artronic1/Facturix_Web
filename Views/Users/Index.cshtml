@model UserIndexViewModel
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="section-title">Usuarios del sistema</h1>
        <p class="section-subtitle">Control de acceso, roles y permisos para Facturix Web.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo usuario</a>
</div>

<div class="card page-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Nombre completo</th>
                        <th>Rol</th>
                        <th>Activo</th>
                        <th>Último acceso</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.NombreUsuario</td>
                        <td>@item.NombreCompleto</td>
                        <td>@item.Rol</td>
                        <td>@(item.Activo ? "Sí" : "No")</td>
                        <td>@(item.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar este usuario?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-sm btn-danger">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
