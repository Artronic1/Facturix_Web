@model UserEditorViewModel
@{
    ViewData["Title"] = Model.Id is null ? "Nuevo usuario" : "Editar usuario";
}

<div class="row">
    <div class="col-lg-7">
        <div class="form-panel">
            <h1 class="section-title">@(Model.Id is null ? "Nuevo usuario" : "Editar usuario")</h1>
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="NombreUsuario" class="form-label"></label>
                        <input asp-for="NombreUsuario" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NombreCompleto" class="form-label"></label>
                        <input asp-for="NombreCompleto" class="form-control" />
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Rol" class="form-label"></label>
                        <select asp-for="Rol" class="form-select">
                            <option value="Admin">Admin</option>
                            <option value="User">User</option>
                        </select>
                    </div>
                </div>
                <div class="form-check mt-3 mb-3">
                    <input asp-for="Activo" class="form-check-input" />
                    <label asp-for="Activo" class="form-check-label"></label>
                </div>
                <div class="mb-4">
                    <label class="form-label">Permisos</label>
                    <div class="row row-cols-1 row-cols-md-2 g-2">
                    @foreach (var permission in Model.PermisosDisponibles)
                    {
                        <div class="col">
                            <label class="form-check border rounded-3 px-3 py-2 w-100">
                                <input class="form-check-input me-2" type="checkbox" name="PermisosSeleccionados" value="@permission" @(Model.PermisosSeleccionados.Contains(permission) ? "checked" : null) />
                                <span class="form-check-label">@permission</span>
                            </label>
                        </div>
                    }
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary">Guardar usuario</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
